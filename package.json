{
  "name": "eventos-palestrantes",
  "version": "1.0.0",
  "description": "Gerenciamento de eventos e palestrantes com Node.js, Express e Prisma",
  "main": "src/server.js",
  "scripts": {
    "postinstall": "prisma generate",
    "setup": "prisma db push --force-reset && node prisma/seed.js",
    "seed": "node prisma/seed.js",
    "start": "node src/server.js",
    "dev": "node --watch src/server.js"
  },
  "dependencies": {
    "@prisma/adapter-better-sqlite3": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "better-sqlite3": "^13.0.3",
    "dotenv": "^18.0.5",
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.4",
    "prisma": "^7.10.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=18"
  }
}
